{
  "name": "gitlab-toggl-timer",
  "private": true,
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "fmt": "oxfmt --write \"src/main/typescript/**/*.ts\"",
    "fmt:check": "oxfmt --check \"src/main/typescript/**/*.ts\""
  },
  "devDependencies": {
    "@types/bootstrap": "5.2.11",
    "air-datepicker": "3.6.0",
    "htmx.org": "4.0.0",
    "oxfmt": "0.67.0",
    "typescript": "7.0.2"
  }
}
