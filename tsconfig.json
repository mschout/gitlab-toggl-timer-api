{
  "compilerOptions": {
    "rootDir": "src/main/typescript",
    "outDir": "build/generated-resources/typescript/static/js",
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmitOnError": true
  },
  "include": [
    "src/main/typescript/**/*.ts"
  ]
}
